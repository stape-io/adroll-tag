  const JSON = require('JSON');

  const expectedValue = 'test';
  const expectedRequestUrl = 'https://srv.adroll.com/api?advertisable=' + expectedValue + '&dry_run=0';
  const expectedRequestOptions = {
    headers: {
      'Content-Type': 'application/json',
      Authorization: 'Token ' + expectedValue
    },
    method: 'POST'
  };
  const expectedRequestBody = {
    "advertisable_eid": expectedValue,
    "pixel_eid": expectedValue,
    "event_name": "pageView",
    "event_attributes": {
      "order_id": expectedValue,
      "products": [
        {
          "product_id": expectedValue,
          "quantity": 1,
          "category": expectedValue,
          "price": expectedValue
        }
      ],
      "keywords": expectedValue,
      "external_data": expectedValue
    },
    "identifiers": {
      "first_party_cookie": expectedValue,
      "email": expectedValue,
      "email_sha256": expectedValue,
      "email_md5": expectedValue,
      "device_id": expectedValue,
      "adct": expectedValue,
      "user_id": expectedValue
    },
    "ip": expectedValue,
